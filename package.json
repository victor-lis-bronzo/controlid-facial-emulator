{
  "name": "controlid-facial-emulator",
  "version": "0.1.0",
  "private": true,
  "description": "A plug-and-play Docker emulator of the Control-iD facial access control reader's HTTP (.fcgi) API, push/webhook mechanism, and web control panel.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "api",
    "web"
  ],
  "scripts": {
    "lint": "npm run lint -w api",
    "lint:fix": "npm run lint:fix -w api",
    "format": "npm run format -w api",
    "test": "npm run test -w api",
    "build": "npm run build -w api",
    "typecheck": "npm run typecheck -w api",
    "dev": "npm run dev -w api"
  }
}
